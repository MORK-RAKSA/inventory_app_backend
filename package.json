{
  "name": "easysell-backend-vercel",
  "version": "1.0.0",
  "private": true,
  "description": "គ្រប់ហាង · EasySell Serverless Backend API for Vercel",
  "main": "api/index.js",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "node -e \"const http=require('http'),h=require('./api/index.js');http.createServer((req,res)=>{res.status=(c)=>{res.statusCode=c;return res};res.json=(o)=>{res.setHeader('Content-Type','application/json');res.end(JSON.stringify(o))};res.send=(b)=>res.end(b);h(req,res)}).listen(process.env.PORT||8080,()=>console.log('EasySell Backend listening on',process.env.PORT||8080))\""
  }
}
