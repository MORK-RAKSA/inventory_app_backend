# ============================================================================
# RetailFlow Spring Boot Backend Environment Variables (`backend/`)
# ============================================================================

PORT=8080

# Database Configuration (H2 file by default; switch to PostgreSQL for cloud production)
DB_URL=jdbc:h2:file:./data/retailflow;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DB_USER=sa
DB_PASSWORD=

# Authentication Credentials
RETAILFLOW_USERNAME=morkraksa
RETAILFLOW_PASSWORD=admin1234

# Optional Cloudflare R2 Image Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
