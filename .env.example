# Copy to .env for local runs (never commit .env). On a host, set these as environment variables.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DB_USER=
DB_PASSWORD=
DB_SCHEMA=prod_app
# Comma-separated browser origins allowed to call the API directly (not needed if you only use the Vercel proxy)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Optional: set only to enable POST /api/auth/reset-password
RECOVERY_KEY=
# Optional: disable Swagger UI in production
SWAGGER_ENABLED=false
# Optional Cloudflare R2 image storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# First-deploy only, if you use bootstrap admin (see DEPLOYMENT.md)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
